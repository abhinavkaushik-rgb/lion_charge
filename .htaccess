<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 301 Redirect direct requests for index.html to https://lioncharge.tech/
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html(\?[^\ ]*)?\ HTTP/ [NC]
  RewriteRule ^index\.html$ https://lioncharge.tech/ [R=301,L]

  # 2. 301 Redirect www.lioncharge.tech to https://lioncharge.tech/
  RewriteCond %{HTTP_HOST} ^www\.lioncharge\.tech$ [NC]
  RewriteRule ^(.*)$ https://lioncharge.tech/$1 [R=301,L]

  # 3. 301 Redirect HTTP to HTTPS for lioncharge.tech
  RewriteCond %{HTTPS} !on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^(.*)$ https://lioncharge.tech/$1 [R=301,L]

  # 4. 301 Redirects for Duplicate / Old Pages to Preferred URLs
  # Duplicate blog pages
  RewriteRule ^blog/lioncharge-ev-charging-hub-old\.html$ https://lioncharge.tech/blog/lioncharge-ev-charging-hub.html [R=301,L]
  RewriteRule ^blog/one-year-post-old\.html$ https://lioncharge.tech/blog/one-year-post.html [R=301,L]
  RewriteRule ^blog/Backup-12-04-2024/lioncharge-ev-charging-hub(-old)?\.html$ https://lioncharge.tech/blog/lioncharge-ev-charging-hub.html [R=301,L]
  RewriteRule ^blog/Backup-12-04-2024/one-year-post(-old)?\.html$ https://lioncharge.tech/blog/one-year-post.html [R=301,L]

  # Duplicate date-versioned pages in root
  RewriteRule ^index-10-11-2024\.html$ https://lioncharge.tech/ [R=301,L]
  RewriteRule ^index-20-11-2024\.html$ https://lioncharge.tech/ [R=301,L]
  RewriteRule ^index-28-03-2025\.html$ https://lioncharge.tech/ [R=301,L]
  RewriteRule ^locate-us-10-11-2024\.html$ https://lioncharge.tech/locate-us.html [R=301,L]

  # Duplicate / Old archived folder pages
  RewriteRule ^Old-05-08-2024/testimonials-and-blogs-19-06-2024\.html$ https://lioncharge.tech/testimonials-and-blogs.html [R=301,L]
  RewriteRule ^Old-[^/]+/index\.html$ https://lioncharge.tech/ [R=301,L]
  RewriteRule ^Old-[^/]+/(.*)$ https://lioncharge.tech/$1 [R=301,L]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
